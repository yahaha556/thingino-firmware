#
# Thingino Custom Profile for Veepai MA5 (T23N + USB AIC8800DC)
#

# 主控芯片架构配置（君正 T23N 属于 ISVP 平台）
BR2_linux_isvp=y
BR2_TARGET_THINGINO_SOC_T23N=y

# 核心驱动调整：关闭默认的 SDIO，强行开启 USB 驱动
# BR2_PACKAGE_THINGINO_DRIVER_AIC8800_SDIO is not set
BR2_PACKAGE_THINGINO_DRIVER_AIC8800_USB=y

# 启用 USB 控制器支持（网卡和虚拟网卡所需总线）
BR2_PACKAGE_LINUX_DRIVERS_USB=y
BR2_PACKAGE_LINUX_DRIVER_DWC2_HCD=y

# 开机环境参数优化（尝试解决松手断电与无线启动）
BR2_TARGET_THINGINO_ENV_DEFAULTS="
gpio_power_hold=16
gpio_wlan_en=14
wlan_bus=usb
"

# 基础包集成（Web控制台、SSH、虚拟网卡网络、无线网络工具）
BR2_PACKAGE_THINGINO_WEBUI=y
BR2_PACKAGE_THINGINO_CONSOLE=y
BR2_PACKAGE_THINGINO_NETWORK=y
BR2_PACKAGE_THINGINO_WIRELESS=y
